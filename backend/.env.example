# Copy this file to backend/.env and fill in only the credentials you own.
# Every value below is intentionally blank or a public default.
# Safe default for deployments; use APP_ENV=development only for local development.
# Never commit backend/.env or paste real credentials into issues, logs, or pull requests.

APP_ENV=production
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# SiliconFlow (ASR, optional LLM, and backup TTS)
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_ASR_FALLBACK_MODEL=TeleAI/TeleSpeechASR
# Used when LLM_PROVIDER=siliconflow.
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_STREAM_MAX_TOKENS=600

# Xunfei Spark (optional)
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# Amap (navigation and weather)
AMAP_API_KEY=
AMAP_SECURITY_CODE=
AMAP_WEB_API_KEY=

# Set these for administrator login; replace the password with a long random value.
# In production, provide them through the deployment secret manager.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional runtime settings
QUERY_REWRITE_USE_LLM=0
WAITRESS_THREADS=8
GUNICORN_WORKERS=4
GUNICORN_THREADS=8
MAX_PRECACHE_TEXTS=30
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
CORS_ALLOWED_ORIGINS=
LINGSHAN_NO_BROWSER=

